# Copy to .env and fill in only what you want. Everything here is OPTIONAL.
# The scraper runs without any credentials; these only add sources or raise limits.

# --- Reddit official API (optional; new apps now need Reddit's manual approval) ---
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=waterboards-feedback-scraper/0.1 by u/your_reddit_name

# --- Phase 2 (optional rate-limit boosts) ---
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=

# --- Phase 3A (optional sources, disabled by default) ---
# BSKY_HANDLE=
# BSKY_APP_PASSWORD=
# MASTODON_INSTANCE=
# MASTODON_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
